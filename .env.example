# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Port auf dem Host
NEOLAP_PORT=8080

# 127.0.0.1 = nur lokal erreichbar (Standard); 0.0.0.0 = im Netz erreichbar (ohne TLS!)
NEOLAP_BIND=127.0.0.1

# Speicherlimit des Containers (ca. 100 Byte je gefüllter Basiszelle; 20 Mio. Zellen ≈ 2,4 GB)
NEOLAP_MEM_LIMIT=4g

# Erster Administrator. Wird beim ersten Start angelegt, wenn die Datenbank noch keinen Benutzer hat;
# danach werden die Werte nicht mehr gebraucht (und sollten aus der Datei entfernt werden).
# Ohne sie startet der Server, aber niemand kann sich anmelden.
# Passwort: mindestens 10 Zeichen.
NEOLAP_ADMIN_USER=admin
# NEOLAP_ADMIN_PASSWORD=

# Log-Level: error, warn, info, debug
NEOLAP_LOG=info

# Fertiges Image statt lokalem Build, z. B. aus der GitHub Container Registry
# NEOLAP_IMAGE=ghcr.io/langdar2/neolap:latest

# Nur für das TLS-Profil (docker compose --profile tls up -d):
# öffentlich auflösbarer Name → automatisches Let's-Encrypt-Zertifikat;
# "localhost" oder interner Name → Caddy-eigenes Zertifikat (Browser-Warnung)
# NEOLAP_DOMAIN=olap.example.de
#
# Hinter dem TLS-Profil müssen Sitzungs-Cookies "Secure" sein und der Server der Adresse vertrauen,
# die Caddy meldet (sonst zählt die Anmeldesperre alle Nutzer als einen Client):
# NEOLAP_SECURE_COOKIES=true
# NEOLAP_TRUST_PROXY=true
